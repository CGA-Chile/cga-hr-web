# Copy to .env.local and fill in. Never commit the filled version.
# This repository is public: a pushed key must be considered burned and rotated.

# --- Supabase ---
# Safe to expose: it ships in the client bundle and is protected by Row Level Security.
# This is why RLS on every table is a hard rule, not a preference.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses Row Level Security entirely.
# Never prefix with NEXT_PUBLIC_. Never commit. Never paste into a chat or an issue.
SUPABASE_SERVICE_ROLE_KEY=

# --- Local development ---
# `npx supabase start` prints these. They are the same on every machine and harmless.
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
